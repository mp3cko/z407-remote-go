<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark with the system, because the page's prefers-color-scheme
         follows the theme. Everything visible is drawn by the page. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:colorAccent">@color/icon_tile</item>
    </style>
</resources>
